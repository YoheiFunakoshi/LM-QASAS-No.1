# Default-deny new top-level items; allow only reviewed project material.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/docs/
!/src/
!/app/
!/tests/
!/scripts/
!/config/
!/.github/
!/pyproject.toml
!/requirements*.txt
!/LICENSE
!/LICENSE.*
!/CHANGELOG.md
!/Start-LMQASAS.cmd

# Explicitly preserve local-only source material and audit/results.
**/LM-QASAS No.1 データ/
**/LM-QASAS No.1 資料/
**/local_records/
**/data/
**/outputs/
**/results/
**/models/
**/checkpoints/
**/cache/

# Environments, build products, editor state, credentials.
**/__pycache__/
**/.venv/
**/venv/
**/node_modules/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/*.egg-info/
**/build/
**/dist/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*
**/Thumbs.db
**/desktop.ini
*.py[cod]

# Research data and derived artifacts are local-only by default.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.arrow
*.feather
*.fasta
*.fa
*.fna
*.faa
*.fastq
*.fq
*.gz
*.zip
*.7z
*.npy
*.npz
*.pt
*.pth
*.safetensors
*.pkl
*.pickle
*.h5
*.hdf5
*.sqlite
*.db
*.pdf
*.docx
*.pptx
*.png
*.jpg
